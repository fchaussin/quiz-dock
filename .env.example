# Copier en `.env` et adapter. Ne jamais committer le `.env` réel.

# --- Marque (white-label) ---
# Nom d'app affiché (header, onglet, partage). Surchargé au runtime sans rebuild.
# Logo + CSS d'override : voir le dossier `branding/` (monté en volume).
APP_NAME=QuizDock
# Langue de l'UI pour cette instance (une seule par déploiement, pas de détection
# navigateur). Valeurs : en (défaut) | fr | es | zh (chinois simplifié) | zh-TW
# (chinois traditionnel).
APP_LANG=en

# --- Auth ---
# none = mode local sans IdP (dev/démo) | oidc = validation JWT d'un fournisseur OIDC
AUTH_MODE=none

# --- OIDC (utilisé seulement si AUTH_MODE=oidc) ---
# N'importe quel fournisseur OpenID Connect (rien de spécifique à un produit).
# OIDC_ISSUER = `iss` attendu dans les jetons (tel que vu par le navigateur).
# OIDC_JWKS_URI : optionnel — sinon résolu via OIDC Discovery
# (`${OIDC_ISSUER}/.well-known/openid-configuration`). À renseigner quand le
# backend joint l'IdP par un autre host que le navigateur (réseau Docker interne).
OIDC_ISSUER=http://localhost:18080/realms/quiz-dock
OIDC_JWKS_URI=http://keycloak:8080/realms/quiz-dock/protocol/openid-connect/certs
# client_id public de la SPA (exposé par GET /auth/config au front).
OIDC_CLIENT_ID=quiz-dock-frontend
# Optionnels : audience attendue (`aud`), et chemin pointé du claim de rôles
# (défaut `roles` ; l'IdP d'exemple ci-dessous les expose sous `realm_access.roles`).
OIDC_AUDIENCE=
OIDC_ROLES_CLAIM=realm_access.roles

# --- Ports exposés (hôte) — peu courants pour éviter les collisions ---
# Mnémo : « 4 » + le port usuel. Ports internes des conteneurs inchangés.
BACKEND_PORT=13000
FRONTEND_PORT=18081
VITE_PORT=15173
POSTGRES_PORT=15432
REDIS_PORT=16379
KEYCLOAK_PORT=18080

# --- PostgreSQL ---
POSTGRES_USER=live
POSTGRES_PASSWORD=live
POSTGRES_DB=quizdock

# --- Médias (volume local servi par le backend) ---
# Taille maximale d'un fichier uploadé (octets). Défaut 10 Mio.
MEDIA_MAX_BYTES=10485760

# --- IdP OIDC d'exemple pour le dev (Keycloak, démarré avec --profile keycloak) ---
# Simple exemple : n'importe quel fournisseur OIDC fait l'affaire en ajustant OIDC_*.
# Identifiants admin de sa console.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ── Live engine tuning (ms) ──────────────────────────────────────────────────
# Automatic mode: time on a reveal / content slide before moving on (per-question
# and per-slide values override it). Reading window before a question's timer.
# GAME_AUTO_ADVANCE_MS=5000
# GAME_READ_DELAY_MS=3000
